@using Microsoft.EntityFrameworkCore
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Turnus</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Turnus.styles.css" asp-append-version="true" />
</head>
<body>
    <partial name="_Overlay" />
    <partial name="_Modal" />
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Turnus</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Schedule" asp-action="Index">Schedule</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        @inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
                        @inject Turnus.Services.ICurrentWorkspaceProvider WorkspaceProvider
                        @inject TurnusContext Db
                        @using System.Security.Claims

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var showAdmin = false;
                            if (User.IsInRole("Manager") || User.IsInRole("SuperAdmin"))
                            {
                                showAdmin = true;
                            }
                            else
                            {
                                var auth = await AuthorizationService.AuthorizeAsync(User, null, "WorkspaceManager");
                                if (auth.Succeeded) showAdmin = true;
                            }

                            if (showAdmin)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Admin" asp-action="Dashboard">Admin</a>
                                </li>
                            }

                            // Workspace selector
                            var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
                            if (!string.IsNullOrEmpty(userId))
                            {
                                var memberships = await Db.WorkspaceMember
                                    .Include(wm => wm.Workspace)
                                    .Where(wm => wm.UserId == userId)
                                    .OrderBy(wm => wm.JoinedAt)
                                    .ToListAsync();

                                if (memberships.Any())
                                {
                                    <li class="nav-item dropdown">
                                        <a class="nav-link dropdown-toggle text-dark" href="#" id="workspaceDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">Workspace</a>
                                        <div class="dropdown-menu dropdown-menu-end" aria-labelledby="workspaceDropdown">
                                            <form method="post" asp-controller="Workspaces" asp-action="SetActive" class="px-3">
                                                @Html.AntiForgeryToken()
                                                <div class="mb-2">
                                                    <select name="id" class="form-select">
                                                        @foreach (var m in memberships)
                                                        {
                                                            <option value="@m.WorkspaceId">@m.Workspace?.Name</option>
                                                        }
                                                    </select>
                                                </div>
                                                <input type="hidden" name="returnUrl" value="@Context.Request.Path + Context.Request.QueryString" />
                                                <button type="submit" class="btn btn-sm btn-primary">Set Active</button>
                                            </form>
                                        </div>
                                    </li>
                                }
                                else
                                {
                                    <li class="nav-item">
                                        <a class="nav-link text-muted" asp-controller="Home" asp-action="Index">No Workspace</a>
                                    </li>
                                }
                            }
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <main role="main" class="container pb-3 flex-grow-1">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Turnus - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/modal.js" asp-append-version="true"></script>
    <script src="~/js/schedule.shiftdetails.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

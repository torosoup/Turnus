@model Turnus.Models.Venue

@{
    ViewData["Title"] = "Venue Details";
}

<h1>@Model.Name</h1>
<hr />

<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Name</dd>
    <dt class="col-sm-2">Created</dt>
    <dd class="col-sm-10">@Model.CreatedAt.ToShortDateString()</dd>
    <dt class="col-sm-2">Departments</dt>
    <dd class="col-sm-10">@Model.Departments.Count</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-outline-secondary ms-2">Back to list</a>
@model Turnus.Controllers.AdminController.DashboardViewModel

@if (Model.SelectedVenue == null)
{
    <div class="alert alert-info">Select a venue to view schedule.</div>
}
else
{
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Schedule for @Model.SelectedVenue.Name (next 6 months)</span>
            <input type="date" class="form-control form-control-sm w-auto"
                   onchange="DashboardSchedule.filterByDate(this.value)" />
        </div>
        <div class="card-body" id="schedule-table-container">
            @foreach (var group in Model.ShiftsByDate)
            {
                <partial name="_ScheduleDayRow" model="group" />
            }
        </div>
    </div>
}

@model Turnus.Controllers.AdminController.DashboardViewModel

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Roles</span>
        <button class="btn btn-sm btn-primary"
                onclick="DashboardRoles.openCreateModal()">
            Create role
        </button>
    </div>
    <div class="card-body">
        @if (!Model.Roles.Any())
        {
            <p>No roles defined.</p>
        }
        else
        {
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Scope</th>
                        <th>Venue</th>
                        <th>Department</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var r in Model.Roles)
                {
                    <tr>
                        <td>@r.Name</td>
                        <td>@r.Scope</td>
                        <td>@r.Venue?.Name</td> 
                        <td>@r.Department?.Name</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-secondary"
                                    onclick="DashboardRoles.openEditModal(@r.Id)">
                                Edit
                            </button>
                            <button class="btn btn-sm btn-danger"
                                    onclick="DashboardRoles.openDeleteModal(@r.Id)">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>

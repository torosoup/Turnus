@model Turnus.Controllers.AdminController.DashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<section class="py-4 bg-light">
    <div id="admin-dashboard" class="container mt-4">
        <h2>Admin Dashboard</h2>

        <!-- Venue selector -->
        <div class="mb-3">
            <label for="venueSelect" class="form-label">Select venue</label>
            <select id="venueSelect" class="form-select"
                    onchange="Dashboard.changeVenue(this.value)">
                @foreach (var v in Model.Venues)
                {
                    <option value="@v.Id" selected="@(Model.SelectedVenue?.Id == v.Id)">
                        @v.Name
                    </option>
                }
            </select>
        </div>

        <!-- AJAX-loaded sections -->
        <partial name="_VenueSettingsSection" model="Model" />
        <partial name="_DepartmentsSection" model="Model" />
        <partial name="_RolesSection" model="Model" />
        <partial name="_ShiftDefinitionsSection" model="Model" />
        <partial name="_StaffingRequirementsSection" model="Model" />
        <partial name="_ScheduleSection" model="Model" />

        <!-- Modal container -->
        <div id="dashboard-modal-container"></div>
    </div>
</section>

@section Scripts {
    <script src="~/js/modal.js"></script>
    <script src="~/js/dashboard.js"></script>
    <script src="~/js/dashboard.venues.js"></script>
    <script src="~/js/dashboard.departments.js"></script>
    <script src="~/js/dashboard.roles.js"></script>
    <script src="~/js/dashboard.schedule.js"></script>
    <script src="~/js/dashboard.shiftdefinitions.js"></script>
    <script src="~/js/dashboard.staffing.js"></script>
    <script src="~/js/dashboard.scheduledshift.js"></script>
    <script src="~/js/dashboard.assignments.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
        const venueId = @Model.SelectedVenue?.Id ?? 0;
        Dashboard.loadSections(venueId);
        });
    </script>

}

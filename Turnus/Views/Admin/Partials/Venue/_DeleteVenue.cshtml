@model Turnus.Models.Venue
<h5 class="modal-title mb-3">Delete Venue</h5>
<form asp-action="Delete" asp-controller="Venues" method="post" id="venue-delete-form">
    <input type="hidden" asp-for="Id" />
    <p>Are you sure you want to delete venue <strong>@Model.Name</strong>?</p>
    <button type="submit" class="btn btn-danger">Delete</button>
</form>

@model Turnus.Models.ShiftAssignment

<div class="modal-header">
    <h5 class="modal-title">Remove assignment</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<div class="modal-body">
    <form asp-action="UnassignShift"
          asp-controller="ShiftAssignment"
          method="post"
          id="unassignshift-form">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <input type="hidden" name="venueId" value="@ViewBag.VenueId" />
        <input type="hidden" name="date" value="@ViewBag.Date" />

        <p>
            Remove
            <strong>@Model.Employee?.FullName</strong>
            from
            <strong>@Model.Role?.Name</strong>
            ?
        </p>

        <button class="btn btn-danger">Unassign</button>

    </form>
</div>

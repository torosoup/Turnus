@model System.Linq.IGrouping<System.DateTime, Turnus.Models.ScheduledShift>

@{
    var date = Model.Key;
}

<div class="mb-2 border rounded">
    <div class="d-flex justify-content-between align-items-center p-2 bg-light">
        <span>@date.ToString("yyyy-MM-dd")</span>  
        <button class="btn btn-sm btn-outline-secondary"
                data-bs-toggle="collapse"
                data-bs-target="#day-@date.ToString("yyyyMMdd")">
            Toggle shifts
        </button>
    </div>
    <div class="collapse" id="day-@date.ToString("yyyyMMdd")">
        <div class="p-2">
            @foreach (var shift in Model)
            {
                <partial name="Partials/ScheduleManagement/_ShiftRow" model="shift" />
            }
        </div>
    </div>
</div>

@model Turnus.Models.ScheduledShift
<div class="modal-header">
    <h5 class="modal-title">Delete Scheduled Shift</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<div class="modal-body">
<form asp-action="Delete" asp-controller="ScheduledShifts" method="post" id="scheduledshift-delete-form">
    <input type="hidden" asp-for="Id" />
    <p>Delete scheduled shift <strong>@Model.ShiftDefinition?.Name</strong> on @Model.Date.ToString("yyyy-MM-dd")?</p>
    <button type="submit" class="btn btn-danger">Delete</button>
</form>
</div>

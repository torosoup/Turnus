@model Turnus.Models.ScheduledShift

<form asp-action="Create" asp-controller="ScheduledShifts" method="post" id="scheduledshift-create-form">
    <input type="hidden" asp-for="VenueId" />
    <input type="hidden" asp-for="DepartmentId" />

    <div class="mb-3">
        <label asp-for="Date" class="form-label"></label>
        <input asp-for="Date" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="ShiftDefinitionId" class="form-label">Shift</label>
        <select asp-for="ShiftDefinitionId" class="form-select"
                asp-items="@(new SelectList(ViewBag.ShiftDefinitions, "Id", "Name"))"></select>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
</form>

@model Turnus.Controllers.AdminController.DashboardViewModel

@if (Model.SelectedVenue == null)
{
    <div class="alert alert-info">
        Select a venue to view schedule.
    </div>
}
else
{
    <div class="card mb-3">

        <div class="card-header d-flex justify-content-between align-items-center">

            <div>
                <strong>Schedule</strong>

                @if (Model.SelectedDepartment != null)
                {
                    <span class="text-muted ms-2">
                        (@Model.SelectedDepartment.Name)
                    </span>
                }
            </div>

            <div class="d-flex align-items-center gap-2">

                <input id="schedule-date-filter"
                       type="date"
                       class="form-control"
                       style="width:180px;"
                       value="@DateTime.Today.ToString("yyyy-MM-dd")" />

                <button class="btn btn-primary"
                        onclick="DashboardScheduledShift.openCreateModal(
                    @Model.SelectedVenue.Id,
                    @Model.SelectedDepartment?.Id ?? 0,
                    document.getElementById('schedule-date-filter').value)">
                    Add Shift
                </button>

            </div>

        </div>

        <div class="card-body" id="schedule-table-container">

            @foreach (var group in Model.ShiftsByDate)
            {
                <partial name="Partials/ScheduleManagement/_ScheduleDayRow"
                         model="group" />
            }

        </div>

    </div>
}
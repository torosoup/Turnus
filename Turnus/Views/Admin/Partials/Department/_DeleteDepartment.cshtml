@model Turnus.Models.Department

<h5 class="modal-title mb-3">Delete Department</h5>
<form asp-action="Delete" asp-controller="Departments" method="post" id="department-delete-form">
    <input type="hidden" asp-for="Id" />
    <p>Are you sure you want to delete department <strong>@Model.Name</strong>?</p>
    <button type="submit" class="btn btn-danger">Delete</button>
</form>

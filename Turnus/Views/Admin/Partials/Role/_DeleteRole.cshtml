@model Turnus.Models.Role

<h5 class="modal-title mb-3">Delete Role</h5>
<form asp-action="Delete" asp-controller="Roles" method="post" id="role-delete-form">
    <input type="hidden" asp-for="Id" />
    <p>Are you sure you want to delete role <strong>@Model.Name</strong>?</p>
    <button type="submit" class="btn btn-danger">Delete</button>
</form>

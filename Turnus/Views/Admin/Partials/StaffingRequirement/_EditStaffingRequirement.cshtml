@model Turnus.Models.VenueStaffingRequirement

<h5 class="modal-title mb-3">Edit Staffing Requirement</h5>
<form asp-action="Edit" asp-controller="StaffingRequirements" method="post" id="staffing-edit-form">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="DepartmentId" />

    <div class="mb-3">
        <label asp-for="RoleId" class="form-label">Role</label>
        <select asp-for="RoleId" class="form-select"
                asp-items="@(new SelectList(ViewBag.Roles, "Id", "Name"))"></select>
    </div>

    <div class="mb-3">
        <label asp-for="RequiredCount" class="form-label"></label>
        <input asp-for="RequiredCount" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="IsShiftScoped" class="form-label"></label>
        <input asp-for="IsShiftScoped" type="checkbox" />
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
</form>

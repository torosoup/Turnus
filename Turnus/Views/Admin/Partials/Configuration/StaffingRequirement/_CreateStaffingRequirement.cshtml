@model Turnus.Models.VenueStaffingRequirement

<h5 class="modal-title mb-3">Create Staffing Requirement</h5>
<form asp-action="Create" asp-controller="StaffingRequirements" method="post" id="staffing-create-form">
    <input type="hidden" asp-for="DepartmentId" />

    <div class="mb-3">
        <label asp-for="RoleId" class="form-label">Role</label>
        <select asp-for="RoleId" class="form-select"
                asp-items="@(new SelectList(ViewBag.Roles, "Id", "Name"))"></select>
    </div>

    <div class="mb-3">
        <label asp-for="RequiredCount" class="form-label"></label>
        <input asp-for="RequiredCount" class="form-control" />
    </div>

    <div class="mb-3 form-check">
        <input type="checkbox" class="form-check-input" id="not-shift-scoped" @(Model.IsShiftScoped ? "" : "checked") />
        <label class="form-check-label" for="not-shift-scoped">
            Not shift-scoped
        </label>
    </div>
    <input type="hidden" asp-for="IsShiftScoped" id="is-shift-scoped" />
    <button type="submit" class="btn btn-primary">Save</button>
</form>
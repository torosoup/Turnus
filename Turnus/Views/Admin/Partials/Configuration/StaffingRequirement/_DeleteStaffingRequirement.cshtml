@model Turnus.Models.VenueStaffingRequirement

<div class="modal-header">
    <h5 class="modal-title">Delete Role</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<div class="modal-body">
<form asp-action="Delete" asp-controller="StaffingRequirements" method="post" id="staffing-delete-form">
    <input type="hidden" asp-for="Id" />
    <p>Delete staffing requirement for role <strong>@Model.Role?.Name</strong>?</p>
    <button type="submit" class="btn btn-danger">Delete</button>
</form>
</div>

@model Turnus.Controllers.AdminController.DashboardViewModel

<div class="card mb-3">
    <div class="card-header">
        <span>Staffing Requirements</span>
    </div>

    <div class="card-body">

        @if (Model.SelectedDepartment == null)
        {
            <p>No department selected.</p>
        }
        else
        {
            var dept = Model.SelectedDepartment;

            <div class="mb-3 border rounded p-2">

                <div class="d-flex justify-content-between align-items-center">
                    <strong>@dept.Name</strong>

                    <button class="btn btn-sm btn-primary"
                            onclick="DashboardStaffing.openCreateModal(@dept.Id)">
                        Add requirement
                    </button>
                </div>

                @if (!Model.StaffingRequirements.Any(r => r.DepartmentId == dept.Id))
                {
                    <p class="text-muted">No staffing requirements.</p>
                }
                else
                {
                    <table class="table table-sm mt-2">
                        <thead>
                            <tr>
                                <th>Role</th>
                                <th>Required</th>
                                <th>Shift-scoped</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var req in Model.StaffingRequirements
                                .Where(r => r.DepartmentId == dept.Id))
                            {
                                <tr>
                                    <td>@req.Role?.Name</td>
                                    <td>@req.RequiredCount</td>
                                    <td>@(req.IsShiftScoped ? "Yes" : "No")</td>

                                    <td class="text-end">
                                        <button class="btn btn-sm btn-secondary"
                                                onclick="DashboardStaffing.openEditModal(@req.Id)">
                                            Edit
                                        </button>

                                        <button class="btn btn-sm btn-danger"
                                                onclick="DashboardStaffing.openDeleteModal(@req.Id)">
                                            Delete
                                        </button>
                                    </td>
                                </tr>
                            }

                        </tbody>
                    </table>
                }

            </div>
        }

    </div>
</div>
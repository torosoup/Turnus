@model Turnus.Models.ShiftDefinition

<div class="modal-header">
    <h5 class="modal-title">Delete Shift Template</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body">
    <form asp-action="Delete" asp-controller="ShiftDefinitions" method="post" id="shiftdefinition-delete-form">
        <input type="hidden" asp-for="Id" />
        <p>Are you sure you want to delete shift template <strong>@Model.Name</strong>?</p>
        <button type="submit" class="btn btn-danger">Delete</button>
    </form>
</div>

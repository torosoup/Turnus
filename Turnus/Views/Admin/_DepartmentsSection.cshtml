@model Turnus.Controllers.AdminController.DashboardViewModel

@if (Model.SelectedVenue == null)
{
    <div class="alert alert-info">Select a venue to manage departments.</div>
}
else
{
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Departments for @Model.SelectedVenue.Name</span>
            <button class="btn btn-sm btn-primary"
                    onclick="DashboardDepartments.openCreateModal(@Model.SelectedVenue.Id)">
                Create department
            </button>
        </div>
        <div class="card-body">
            @if (!Model.Departments.Any())
            {
                <p>No departments for this venue.</p>
            }
            else
            {
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var d in Model.Departments)
                    {
                        <tr>
                            <td>@d.Name</td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-secondary"
                                        onclick="DashboardDepartments.openEditModal(@d.Id)">
                                    Edit
                                </button>
                                <button class="btn btn-sm btn-danger"
                                        onclick="DashboardDepartments.openDeleteModal(@d.Id)">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@model Turnus.Models.Department

@{
    ViewData["Title"] = "Delete Department";
}

<h1>Delete Department</h1>
<h3>Are you sure you want to delete this department?</h3>
<div class="alert alert-warning">
    Deleting a department will also remove its shift definitions and staffing requirements.
</div>

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>
    <dt class="col-sm-3">Venue</dt>
    <dd class="col-sm-9">@Model.Venue?.Name</dd>
</dl>

<form asp-action="Delete">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
</form>
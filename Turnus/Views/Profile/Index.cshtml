@using Turnus.Models
@model Turnus.Models.ApplicationUser

@{
    ViewData["Title"] = "My Profile";
    var shiftAssignments = ViewBag.ShiftAssignments as List<Turnus.Models.ShiftAssignment>;
    var dayAssignments = ViewBag.DayAssignments as List<Turnus.Models.DayAssignment>;
}

<div class="container mt-4">
    <div class="row">
        <partial name="_ProfileSidebar" />

        <div class="col-md-9">

            @* Profile summary *@
            <div class="card mb-4">
                <div class="card-header"><h5 class="mb-0">Overview</h5></div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-3">Full name</dt>
                        <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.FullName) ? "Not set" : Model.FullName)</dd>
                        <dt class="col-sm-3">Email</dt>
                        <dd class="col-sm-9">@Model.Email</dd>
                        <dt class="col-sm-3">Phone</dt>
                        <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Not set" : Model.PhoneNumber)</dd>
                    </dl>
                </div>
            </div>

            @* Upcoming shifts *@
            <div class="card mb-4">
                <div class="card-header"><h5 class="mb-0">Upcoming shifts</h5></div>
                <div class="card-body">
                    @if ((!shiftAssignments?.Any() ?? true) && (!dayAssignments?.Any() ?? true))
                    {
                        <p class="text-muted">No upcoming shifts assigned.</p>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var a in shiftAssignments ?? new())
                            {
                                <a asp-controller="Schedule" asp-action="ShiftDetail"
                                   asp-route-id="@a.ScheduledShiftId"
                                   class="badge bg-primary text-decoration-none p-2"
                                   style="font-size:0.85rem;">
                                    <div>@a.ScheduledShift?.ScheduledDay?.Venue?.Name</div>
                                    <div>@a.ScheduledShift?.ScheduledDay?.Date.ToShortDateString()</div>
                                    <div>@a.ScheduledShift?.ShiftDefinition?.Name</div>
                                    <div>@a.ScheduledShift?.ShiftDefinition?.StartTime - @a.ScheduledShift?.ShiftDefinition?.EndTime</div>
                                </a>
                            }
                            @foreach (var a in dayAssignments ?? new())
                            {
                                <div class="badge bg-info p-2" style="font-size:0.85rem;">
                                    <div>@a.ScheduledDay?.Venue?.Name</div>
                                    <div>@a.ScheduledDay?.Date.ToShortDateString()</div>
                                    <div>@a.Role?.Name (all day)</div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</div>
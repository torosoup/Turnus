@{
    ViewData["Title"] = "Security";
}

<div class="container mt-4">
    <div class="row">
        <partial name="_ProfileSidebar" />

        <div class="col-md-9">
            <div class="card">
                <div class="card-header"><h5 class="mb-0">Security</h5></div>
                <div class="card-body">

                    <dl class="row">
                        <dt class="col-sm-5">Two-factor authentication</dt>
                        <dd class="col-sm-7">
                            @if ((bool)ViewBag.TwoFactorEnabled)
                            {
                                <span class="badge bg-success">Enabled</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Disabled</span>
                            }
                        </dd>

                        <dt class="col-sm-5">Email confirmed</dt>
                        <dd class="col-sm-7">
                            @if ((bool)ViewBag.EmailConfirmed)
                            {
                                <span class="badge bg-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">No</span>
                            }
                        </dd>

                        <dt class="col-sm-5">Phone confirmed</dt>
                        <dd class="col-sm-7">
                            @if ((bool)ViewBag.PhoneNumberConfirmed)
                            {
                                <span class="badge bg-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">No</span>
                            }
                        </dd>
                    </dl>

                    <div class="alert alert-info mt-3">
                        Additional security features (2FA setup, active sessions) will be available in a future update.
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
@using Turnus.Controllers
@model ScheduleController.WeekScheduleViewModel

@{
    ViewData["Title"] = "Schedule";
    var dayNames = new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };
}

<div class="container-fluid mt-3">

    @* Week navigation header *@
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div class="d-flex align-items-center gap-3">
            @if (Model.CanGoPrevious)
            {
                <a asp-action="Index" asp-route-week="@Model.PreviousWeek" asp-route-venueId="@Model.SelectedVenueId" asp-route-departmentId="@Model.SelectedDepartmentId" class="btn btn-outline-secondary btn-sm">&#8592;</a>
            }
            else
            {
                <button class="btn btn-outline-secondary btn-sm" disabled>&#8592;</button>
            }

            <h5 class="mb-0">Week @Model.WeekNumber, @Model.Year</h5>

            @if (Model.CanGoNext)
            {
                <a asp-action="Index" asp-route-week="@Model.NextWeek" asp-route-venueId="@Model.SelectedVenueId" asp-route-departmentId="@Model.SelectedDepartmentId" class="btn btn-outline-secondary btn-sm">&#8594;</a>
            }
            else
            {
                <button class="btn btn-outline-secondary btn-sm" disabled>&#8594;</button>
            }
        </div>

        @* Venue selector or display *@
        <div>
            @if (Model.Venues.Count > 1)
            {
                <form method="get" asp-action="Index" class="d-inline">
                    <input type="hidden" name="week" value="@Model.CurrentWeek" />
                    <select name="venueId" class="form-select form-select-sm d-inline" style="width:auto;" onchange="this.form.submit()">
                        @foreach (var venue in Model.Venues)
                        {
                            <option value="@venue.Id" selected="@(venue.Id == Model.SelectedVenueId)">@venue.Name</option>
                        }
                    </select>

                    @* Department filter for the selected venue *@
                    @if (Model.Departments != null && Model.Departments.Any())
                    {
                        <select name="departmentId" class="form-select form-select-sm d-inline ms-2" style="width:auto;" onchange="this.form.submit()">
                            <option value="" selected="@(Model.SelectedDepartmentId == 0)">All departments</option>
                            @foreach (var d in Model.Departments)
                            {
                                <option value="@d.Id" selected="@(d.Id == Model.SelectedDepartmentId)">@d.Name</option>
                            }
                        </select>
                    }
                </form>
            }
            else if (Model.Venues.Count == 1)
            {
                <span class="badge bg-secondary">@Model.Venues.First().Name</span>

                @* still show department filter when single venue *@
                @if (Model.Departments != null && Model.Departments.Any())
                {
                    <form method="get" asp-action="Index" class="d-inline ms-2">
                        <input type="hidden" name="week" value="@Model.CurrentWeek" />
                        <input type="hidden" name="venueId" value="@Model.SelectedVenueId" />
                        <select name="departmentId" class="form-select form-select-sm d-inline" style="width:auto;" onchange="this.form.submit()">
                            <option value="" selected="@(Model.SelectedDepartmentId == 0)">All departments</option>
                            @foreach (var d in Model.Departments)
                            {
                                <option value="@d.Id" selected="@(d.Id == Model.SelectedDepartmentId)">@d.Name</option>
                            }
                        </select>
                    </form>
                }
            }
        </div>
    </div>

    @* Schedule table *@
    <div class="table-responsive">
        <table class="table table-bordered table-sm" role="grid" aria-label="Weekly schedule">
            <thead class="table-dark">
                <tr>
                    <th scope="col" style="min-width:120px;">Employee</th>
                    @foreach (var day in Model.WeekDays)
                    {
                        <th scope="col" class="text-center" style="min-width:130px;">
                            @day.ToString("ddd dd/MM")
                        </th>
                    }
                </tr>
            </thead>
            <tbody>

                @* Row 1 — current user's own assignments *@
                <tr class="table-primary">
                    <td><strong>My shifts</strong></td>
                    @foreach (var day in Model.WeekDays)
                    {
                        var myShifts = Model.MyShiftAssignmentsForDay(day);
                        <td class="text-center align-middle">
                            @if (!myShifts.Any())
                            {
                                <span class="text-muted small">No shift</span>
                            }
                            else
                            {
                                @foreach (var a in myShifts)
                                {
                                    @* <div class="badge bg-primary mb-1 d-block" 
                                         role="gridcell" 
                                         tabindex="0"
                                         aria-label="@a.ScheduledShift?.ScheduledDay?.Venue?.Name @a.ScheduledShift?.ShiftDefinition?.Name @a.ScheduledShift?.ShiftDefinition?.StartTime - @a.ScheduledShift?.ShiftDefinition?.EndTime">
                                        <div class="small">@a.ScheduledShift?.ScheduledDay?.Venue?.Name</div>
                                        <div class="small">@a.ScheduledShift?.ShiftDefinition?.Name</div>
                                        <div class="small">@a.ScheduledShift?.ShiftDefinition?.StartTime - @a.ScheduledShift?.ShiftDefinition?.EndTime</div>
                                    </div> *@

                                    <a href="#"
                                       onclick="openShiftDetail(@a.ScheduledShiftId, '@Model.CurrentWeek')"
                                       class="badge bg-primary mb-1 d-block text-decoration-none"
                                       role="gridcell"
                                       tabindex="0"
                                       aria-label="My shift: @a.ScheduledShift?.Venue?.Name @a.ScheduledShift?.Department?.Name - @a.ScheduledShift?.ShiftDefinition?.Name @a.ScheduledShift?.ShiftDefinition?.StartTime - @a.ScheduledShift?.ShiftDefinition?.EndTime">
                                        <div class="small">@a.ScheduledShift?.Venue?.Name</div>
                                        <div class="small">@a.ScheduledShift?.Department?.Name - @a.ScheduledShift?.ShiftDefinition?.Name</div>
                                        <div class="small">@a.ScheduledShift?.ShiftDefinition?.StartTime - @a.ScheduledShift?.ShiftDefinition?.EndTime</div>
                                    </a>
                                }
                            }
                        </td>
                    }
                </tr>

                @* Row 2 — open slots *@
                <tr class="table-warning">
                    <td><strong>Open slots</strong></td>
                    @foreach (var day in Model.WeekDays)
                    {
                        var shiftsThisDay = Model.ShiftsForDay(day);
                        var openShifts = shiftsThisDay.Where(s => Model.ShiftHasOpenSlots(s, Model.Requirements)).ToList();
                        var hasOpen = openShifts.Any();
                        <td class="text-center align-middle">
                            @if (hasOpen)
                            {
                                @foreach (var shift in openShifts)
                                {
                                    <a href="#"
                                       onclick="openShiftDetail(@shift.Id, '@Model.CurrentWeek')"
                                       class="badge bg-warning text-dark mb-1 d-block text-decoration-none"
                                       role="gridcell"
                                       tabindex="0"
                                       aria-label="Open shift: @shift.Venue?.Name @shift.Department?.Name - @shift.ShiftDefinition?.Name @shift.ShiftDefinition?.StartTime - @shift.ShiftDefinition?.EndTime">

                                        <div class="small">@shift.Venue?.Name</div>
                                        <div class="small">@shift.Department?.Name - @shift.ShiftDefinition?.Name</div>
                                        <div class="small">
                                            @shift.ShiftDefinition?.StartTime - @shift.ShiftDefinition?.EndTime
                                        </div>

                                    </a>
                                }
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                    }
                </tr>

                @* Remaining rows — other employees *@
                @foreach (var employee in Model.OtherEmployees())
                {
                    <tr>
                        <td class="align-middle">
                            <span class="small">@(string.IsNullOrEmpty(employee.FullName) ? employee.Email : employee.FullName)</span>
                        </td>
                        @foreach (var day in Model.WeekDays)
                        {
                            var theirShifts = Model.ShiftAssignmentsForEmployeeOnDay(employee.Id, day);
                            <td class="text-center align-middle">
                                @foreach (var a in theirShifts)
                                {
                                    @* <div class="badge bg-secondary mb-1 d-block"
                                         role="gridcell"
                                         tabindex="0"
                                         aria-label="@a.ScheduledShift?.ScheduledDay?.Venue?.Name @a.ScheduledShift?.ShiftDefinition?.Name">
                                        <div class="small">@a.ScheduledShift?.ScheduledDay?.Venue?.Name</div>
                                        <div class="small">@a.ScheduledShift?.ShiftDefinition?.Name</div>
                                        <div class="small">@a.ScheduledShift?.ShiftDefinition?.StartTime - @a.ScheduledShift?.ShiftDefinition?.EndTime</div>
                                    </div> *@

                                    @* In "My shifts" row — replace the div with: *@
                                    <a href="#"
                                       onclick="openShiftDetail(@a.ScheduledShiftId, '@Model.CurrentWeek')"
                                       class="badge bg-secondary mb-1 d-block text-decoration-none"
                                       role="gridcell"
                                       tabindex="0"
                                       aria-label="Assigned shift: @a.ScheduledShift?.Venue?.Name @a.ScheduledShift?.Department?.Name - @a.ScheduledShift?.ShiftDefinition?.Name @a.ScheduledShift?.ShiftDefinition?.StartTime - @a.ScheduledShift?.ShiftDefinition?.EndTime">
                                        <div class="small">@a.ScheduledShift?.Venue?.Name</div>
                                        <div class="small">@a.ScheduledShift?.Department?.Name - @a.ScheduledShift?.ShiftDefinition?.Name</div>
                                        <div class="small">@a.ScheduledShift?.ShiftDefinition?.StartTime - @a.ScheduledShift?.ShiftDefinition?.EndTime</div>

                                    </a>
                                }
                                @if (!theirShifts.Any())
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                        }
                    </tr>
                }

            </tbody>
        </table>
    </div>
</div>
<!-- Shift Detail Modal -->
<div class="modal fade" id="shiftDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" id="shiftDetailModalContent">
            <!-- Partial gets loaded here -->
        </div>
    </div>
</div>

@section Scripts {
    <script>

        function openShiftDetail(id, week) {

            fetch(`/Schedule/ShiftDetail?id=${id}&week=${week}`)
                .then(response => {

                    if (!response.ok) {
                        throw new Error("Failed to load shift details");
                    }

                    return response.text();
                })
                .then(html => {

                    document.getElementById(
                        "shiftDetailModalContent"
                    ).innerHTML = html;


                    const modal = new bootstrap.Modal(
                        document.getElementById("shiftDetailModal")
                    );

                    modal.show();

                })
                .catch(error => {
                    console.error(error);
                });
        }

    </script>
}
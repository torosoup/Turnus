@using Turnus.Models
@model Turnus.Models.ScheduledShift

@{
    ViewData["Title"] = "Shift Details";
    var requirements = ViewBag.Requirements as List<Turnus.Models.VenueStaffingRequirement>;
    var myAvailability = ViewBag.MyAvailability as Turnus.Models.Availability;
    var returnWeek = ViewBag.ReturnWeek as string;
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Shift Details</h5>
            <a asp-action="Index" asp-route-week="@returnWeek" class="btn btn-sm btn-outline-secondary">← Back to schedule</a>
        </div>
        <div class="card-body">

            @* Shift summary *@
            <dl class="row mb-3">
                <dt class="col-sm-4">Venue</dt>
                <dd class="col-sm-8">@Model.ScheduledDay?.Venue?.Name</dd>

                <dt class="col-sm-4">Date</dt>
                <dd class="col-sm-8">@Model.ScheduledDay?.Date.ToLongDateString()</dd>

                <dt class="col-sm-4">Shift</dt>
                <dd class="col-sm-8">@Model.ShiftDefinition?.Name</dd>

                <dt class="col-sm-4">Start</dt>
                <dd class="col-sm-8">@Model.ShiftDefinition?.StartTime</dd>

                <dt class="col-sm-4">End</dt>
                <dd class="col-sm-8">@Model.ShiftDefinition?.EndTime</dd>
            </dl>

            <hr />

            @* Required roles and current assignments *@
            <h6>Staffing</h6>
            @if (requirements == null || !requirements.Any())
            {
                <p class="text-muted small">No shift-scoped roles defined for this venue.</p>
            }
            else
            {
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Role</th>
                            <th>Required</th>
                            <th>Assigned</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var req in requirements)
                    {
                        var assigned = Model.ShiftAssignments.Where(a => a.RoleId == req.RoleId).ToList();
                        <tr>
                            <td>@req.Role?.Name</td>
                            <td>@req.RequiredCount</td>
                            <td>
                                @if (!assigned.Any())
                                {
                                    <span class="text-muted">None yet</span>
                                }
                                else
                                {
                                    @string.Join(", ", assigned.Select(a =>
                                        string.IsNullOrEmpty(a.Employee?.FullName)
                                            ? a.Employee?.Email
                                            : a.Employee?.FullName))
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }

            <hr />

            @* Availability section *@
            <h6>Your availability</h6>

            @if (myAvailability == null)
            {
                <p class="text-muted small mb-2">You haven't responded yet.</p>
            }
            else if (myAvailability.IsAvailable)
            {
                <p class="text-success small mb-2">✓ You marked yourself <strong>available</strong> for this shift.</p>
            }
            else
            {
                <p class="text-danger small mb-2">✗ You marked yourself <strong>unavailable</strong> for this shift.</p>
            }

            <div class="d-flex gap-2">
                <form asp-controller="Availabilities" asp-action="SetAvailability" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="scheduledShiftId" value="@Model.Id" />
                    <input type="hidden" name="isAvailable" value="true" />
                    <button type="submit"
                            class="btn btn-sm @(myAvailability?.IsAvailable == true ? "btn-success" : "btn-outline-success")">
                        ✓ Available
                    </button>
                </form>

                <form asp-controller="Availabilities" asp-action="SetAvailability" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="scheduledShiftId" value="@Model.Id" />
                    <input type="hidden" name="isAvailable" value="false" />
                    <button type="submit"
                            class="btn btn-sm @(myAvailability?.IsAvailable == false ? "btn-danger" : "btn-outline-danger")">
                        ✗ Unavailable
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>
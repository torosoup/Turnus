@model Turnus.Models.ScheduleReviewViewModel

@{
    var shift = Model.Shift;
    var venue = Model.Venue;
    var date = Model.Date;
    var availability = Model.Availability;
    var requirementsForShift = Model.Requirements
        .Where(r => r.DepartmentId == shift.DepartmentId)
        .ToList();
}

<div class="border rounded p-3 mb-3">

    <strong>
        @Model.Shift.Department?.Name
        —
        @Model.Shift.ShiftDefinition?.Name
    </strong>

    <div class="text-muted small">
        @Model.Shift.ShiftDefinition?.StartTime -
        @Model.Shift.ShiftDefinition?.EndTime
    </div>


    @foreach (var req in requirementsForShift)
    {
        var assigned = Model.Shift.ShiftAssignments
            .Where(a => a.RoleId == req.RoleId)
            .ToList();

        var availableForShift = Model.Availability
            .Where(a => a.ScheduledShiftId == Model.Shift.Id)
            .ToList();

        <div class="mb-3">

            <div class="d-flex justify-content-between">
                <strong>@req.Role?.Name</strong>

                <span class="text-muted small">
                    Need @req.RequiredCount |
                    Assigned @assigned.Count
                </span>
            </div>

            <partial name="_AssignedEmployees.cshtml"
                     model="assigned" />

            <partial name="_AvailableEmployees.cshtml"
                 model="new Turnus.Models.AvailableEmployeesViewModel
                 {
                     Shift = Model.Shift,
                     Requirement = req,
                     Available = availableForShift,
                     Assigned = assigned,
                     Venue = Model.Venue,
                     Date = Model.Date
                 }" />

</div>
    }
</div>